{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "Image", "url": "${lumi}", "width": "64px", "altText": "Lumi" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "${titulo}", "weight": "Bolder", "size": "Medium", "wrap": true },
            { "type": "TextBlock", "text": "${mensagem}", "wrap": true, "spacing": "Small", "isSubtle": true }
          ]
        }
      ]
    },
    {
      "type": "Container",
      "separator": true,
      "spacing": "Medium",
      "selectAction": { "type": "Action.Execute", "verb": "abrir-santo" },
      "items": [
        { "type": "TextBlock", "text": "${rotuloDoSanto}", "size": "Small", "weight": "Bolder", "color": "Accent" },
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column",
              "width": "auto",
              "items": [
                { "type": "Image", "url": "${fotoDoSanto}", "width": "48px", "height": "48px", "style": "Person", "altText": "${nomeDoSanto}" }
              ]
            },
            {
              "type": "Column",
              "width": "stretch",
              "verticalContentAlignment": "Center",
              "items": [
                { "type": "TextBlock", "text": "${nomeDoSanto}", "weight": "Bolder", "wrap": true },
                { "type": "TextBlock", "text": "${resumoDoSanto}", "wrap": true, "size": "Small", "isSubtle": true, "maxLines": 2 }
              ]
            }
          ]
        }
      ]
    }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "${botao}", "verb": "abrir-missao" }
  ]
}
